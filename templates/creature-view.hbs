<section class="creature-detail-wrapper bestiary-scrollable">
  {{#if error}}
    {{#if unavailable}}
      <div class="suite-empty-state"><i class="fas fa-eye-slash"></i><h2>{{localize "BESTIARY.CreatureUnavailable"}}</h2></div>
    {{else}}
      <div class="suite-empty-state"><i class="fas fa-triangle-exclamation"></i><h2>{{localize "BESTIARY.CreatureLoadError"}}</h2></div>
    {{/if}}
  {{else}}
    <div class="creature-detail-view">

      <header class="creature-topbar">
        <div class="creature-topbar-left">
          <span class="tier-chip is-{{tierBadge.key}} is-large"><i class="fas {{tierBadge.icon}}"></i>{{tierBadge.label}}</span>
          {{#if locked}}<span class="suite-badge is-locked is-inline"><i class="fas fa-lock"></i>{{localize "BESTIARY.Lock.Locked"}}</span>{{/if}}
          {{#each collections}}
            <span class="creature-collection-tag"><i class="far fa-folder"></i>{{this.sectionName}}{{#if this.familyName}} · {{this.familyName}}{{/if}}</span>
          {{/each}}
        </div>

        <div class="creature-topbar-right">
          {{#if isGM}}
            <label class="preview-as">
              <i class="fas fa-user-secret"></i>
              <select class="preview-as-select">
                {{#each previewOptions}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
              </select>
            </label>
            {{#if hasEntry}}
              <button type="button" class="suite-icon-button" data-action="openEntryEditor" data-tooltip="{{localize 'BESTIARY.Entry.Title'}}"><i class="fas fa-sliders"></i></button>
              <button type="button" class="suite-icon-button {{#if locked}}is-active{{/if}}" data-action="toggleLock" data-tooltip="{{lockLabel}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
            {{/if}}
            <button type="button" class="suite-icon-button" data-action="openSheet" data-tooltip="{{localize 'BESTIARY.OpenSheet'}}"><i class="fas fa-arrow-up-right-from-square"></i></button>
          {{/if}}
          <button type="button" class="suite-icon-button {{#if isFavorite}}is-active{{/if}}" data-action="toggleFavorite" data-tooltip="{{localize 'BESTIARY.ToggleFavorite'}}"><i class="{{#if isFavorite}}fas{{else}}far{{/if}} fa-star"></i></button>
          <button type="button" class="suite-icon-button" data-action="sendToChat" data-tooltip="{{localize 'BESTIARY.SendToChat'}}"><i class="far fa-message"></i></button>
          {{#if shareEnabled}}
            <button type="button" class="suite-primary-button is-compact" data-action="shareCreature"><i class="fas fa-share-nodes"></i>{{localize "BESTIARY.Share.Button"}}</button>
          {{/if}}
        </div>
      </header>

      {{#if isPreviewing}}
        <div class="preview-banner">
          <i class="fas fa-eye"></i>
          <span>{{localize "BESTIARY.Preview.Banner"}} <strong>{{previewUserName}}</strong></span>
          <button type="button" data-action="clearPreview">{{localize "BESTIARY.Preview.Exit"}}</button>
        </div>
      {{/if}}

      <header class="creature-profile-card">
        <div class="creature-portrait {{image.frameClass}}">
          {{#if image.useBackdrop}}<div class="bestiary-frame-backdrop" style="{{image.backdropStyle}}"></div>{{/if}}
          <img src="{{image.src}}" alt="{{creature.displayName}}" style="{{image.imageStyle}}" />
        </div>

        <div class="creature-profile-main">
          <div class="creature-profile-heading">
            <p class="creature-kicker">{{localize "BESTIARY.CreatureProfile"}}</p>
            <h1 class="{{#unless creature.knowsName}}is-unknown{{/unless}}">{{#each (bjNameParts creature.displayName)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</h1>
            <p class="creature-type-line">{{creature.typeLabel}}{{#if creature.showAlignment}} · {{creature.alignment}}{{/if}}</p>
          </div>

          <ol class="tier-ladder" aria-label="{{localize 'BESTIARY.Tier.Ladder'}}">
            {{#each tierSteps}}
              <li class="{{#if this.reached}}is-reached{{/if}} {{#if this.isCurrent}}is-current{{/if}}">
                <i class="fas {{this.icon}}"></i><span>{{this.label}}</span>
              </li>
            {{/each}}
          </ol>

          {{#if showVitals}}
            <div class="creature-key-stats">
              {{#if showBlock.ac}}<div class="key-stat"><span>{{localize "BESTIARY.ACShort"}}</span><strong>{{creature.ac.value}}</strong></div>{{/if}}
              {{#if showBlock.hp}}
                <div class="key-stat hp-stat {{#if creature.lowHp}}is-danger{{/if}}">
                  <span>{{localize "BESTIARY.HP"}}</span><strong>{{creature.hp.max}}</strong>
                  {{#if creature.hp.formula}}<small class="hp-formula">{{creature.hp.formula}}</small>{{/if}}
                </div>
              {{/if}}
              {{#if showBlock.cr}}<div class="key-stat"><span>{{localize "BESTIARY.CRShort"}}</span><strong>{{creature.crFormatted}}</strong></div>{{/if}}
              {{#if showBlock.xp}}<div class="key-stat"><span>{{localize "BESTIARY.XP"}}</span><strong>{{creature.xp}}</strong></div>{{/if}}
            </div>
          {{/if}}

          {{#if showBlock.speed}}
            <div class="creature-movement-line">
              <i class="fas fa-wind"></i>
              <div>
                {{#each speedEntries}}<span><strong>{{this.label}}</strong> {{this.value}}</span>{{/each}}
                {{#each creature.movementTraits}}<em>{{this}}</em>{{/each}}
              </div>
            </div>
          {{/if}}
        </div>
      </header>

      <div class="creature-body">
        <div class="creature-main-column">
          {{#if isBlank}}
            <div class="suite-empty-state is-inline">
              <i class="fas fa-circle-question"></i>
              <h2>{{localize "BESTIARY.Tier.NothingKnown"}}</h2>
              <p>{{localize "BESTIARY.Tier.NothingKnownHint"}}</p>
            </div>
          {{/if}}

          {{#if showAbilities}}
            <section class="creature-content-card ability-section">
              <header>
                <div><p>{{localize "BESTIARY.CoreStats"}}</p><h2>{{localize "BESTIARY.Abilities"}}</h2></div>
              </header>
              <div class="ability-scores-grid">
                {{#each abilityEntries}}
                  <div class="ability-score" title="{{this.fullLabel}}">
                    <span>{{this.label}}</span><strong>{{this.value}}</strong><em>{{this.mod}}</em>
                    <small>{{localize "BESTIARY.SaveShort"}} {{this.save}}</small>
                  </div>
                {{/each}}
              </div>
            </section>
          {{/if}}

          <div class="creature-info-grid">
            {{#if showBlock.skills}}
              <section class="creature-content-card compact-info-card">
                <header><div><p>{{localize "BESTIARY.Proficiencies"}}</p><h2>{{localize "BESTIARY.Skills"}}</h2></div><i class="fas fa-hand-sparkles"></i></header>
                <div class="trait-chip-list">{{#each skillEntries}}<span>{{this.label}} <strong>{{this.total}}</strong></span>{{/each}}</div>
              </section>
            {{/if}}
            {{#if showBlock.senses}}
              <section class="creature-content-card compact-info-card">
                <header><div><p>{{localize "BESTIARY.Perception"}}</p><h2>{{localize "BESTIARY.Senses"}}</h2></div><i class="far fa-eye"></i></header>
                <div class="trait-chip-list">{{#each senseEntries}}<span>{{this.label}} <strong>{{this.value}}</strong></span>{{/each}}</div>
              </section>
            {{/if}}
            {{#if showBlock.languages}}
              <section class="creature-content-card compact-info-card">
                <header><div><p>{{localize "BESTIARY.Communication"}}</p><h2>{{localize "BESTIARY.Languages"}}</h2></div><i class="fas fa-language"></i></header>
                <div class="trait-chip-list">{{#each creature.languages}}<span>{{this}}</span>{{/each}}</div>
              </section>
            {{/if}}
            {{#if showDefenses}}
              <section class="creature-content-card compact-info-card">
                <header><div><p>{{localize "BESTIARY.Defense"}}</p><h2>{{localize "BESTIARY.Defenses"}}</h2></div><i class="fas fa-shield-halved"></i></header>
                <div class="trait-chip-list">
                  {{#if showBlock.resistances}}{{#each creature.resistances}}<span>{{this}}</span>{{/each}}{{/if}}
                  {{#if showBlock.immunities}}{{#each creature.immunities}}<span class="is-positive">{{this}}</span>{{/each}}{{/if}}
                  {{#if showBlock.vulnerabilities}}{{#each creature.vulnerabilities}}<span class="is-danger">{{this}}</span>{{/each}}{{/if}}
                  {{#if showBlock.conditionImmunities}}{{#each creature.conditionImmunities}}<span>{{this}}</span>{{/each}}{{/if}}
                </div>
              </section>
            {{/if}}
          </div>

          {{#if hasContent}}
            <nav class="creature-section-nav">
              {{#each contentSections}}
                <button type="button" data-action="toggleSection" data-section-key="{{this.key}}">
                  <i class="fas {{this.icon}}"></i>{{this.label}}{{#if this.count}}<span>{{this.count}}</span>{{/if}}
                </button>
              {{/each}}
            </nav>

            <div class="creature-expanded-layout">
              {{#each contentSections}}
                <section class="creature-items-accordion {{#if this.expanded}}is-expanded{{/if}} {{#if this.blockHiddenForPlayers}}is-gm-only{{/if}}" data-content-section="{{this.key}}">
                  <button type="button" class="section-toggle" data-action="toggleSection" data-section-key="{{this.key}}">
                    <span class="section-icon"><i class="fas {{this.icon}}"></i></span>
                    <span class="section-label"><small>{{localize "BESTIARY.Section"}}</small><strong>{{this.label}}</strong></span>
                    {{#if this.blockHiddenForPlayers}}<em class="section-gm-flag"><i class="fas fa-eye-slash"></i>{{localize "BESTIARY.Tier.GmOnly"}}</em>{{/if}}
                    {{#if this.count}}<em>{{this.count}}</em>{{/if}}
                    <i class="fas section-chevron {{#if this.expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
                  </button>

                  <div class="accordion-section-body {{#unless this.expanded}}is-collapsed{{/unless}}">
                    {{#if this.isBiography}}
                      <div class="creature-biography-content">{{{this.biography}}}</div>
                    {{else}}
                      <div class="creature-items-list">
                        {{#each this.items}}
                          <article class="creature-item {{#if this.expanded}}is-expanded{{/if}} {{#if this.hiddenForPlayers}}is-item-hidden{{/if}}" data-item-key="{{this.itemKey}}" data-action="expandItem" tabindex="0" aria-expanded="{{#if this.expanded}}true{{else}}false{{/if}}">
                            <div class="creature-item-header">
                              <img class="item-icon" src="{{this.img}}" alt="" />
                              <div class="item-heading">
                                <strong>{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</strong>
                                <div class="item-inline-meta">
                                  {{#if this.primaryActivity.typeLabel}}<span>{{this.primaryActivity.typeLabel}}</span>{{/if}}
                                  {{#if this.primaryActivity.attack}}<span>{{this.primaryActivity.attack}}</span>{{/if}}
                                  {{#if this.primaryActivity.range}}<span>{{this.primaryActivity.range}}</span>{{/if}}
                                </div>
                              </div>
                              {{#if this.primaryActivity.damage}}<span class="item-damage-chip">{{this.primaryActivity.damage}}</span>{{/if}}

                              {{#if ../../isGM}}
                                <label class="item-tier-control" data-tooltip="{{localize 'BESTIARY.Tier.ItemHint'}}">
                                  <i class="fas fa-eye"></i>
                                  <select data-item-tier data-block-key="{{this.blockKey}}" data-item-id="{{this.itemId}}" {{#if ../../locked}}disabled{{/if}}>
                                    {{#each this.tierChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
                                  </select>
                                </label>
                              {{/if}}

                              <i class="fas creature-item-chevron {{#if this.expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
                            </div>

                            <div class="creature-item-body {{#unless this.expanded}}is-collapsed{{/unless}}">
                              {{#if this.tags.length}}
                                <div class="creature-item-tags">{{#each this.tags}}<span class="item-tag {{#if this.isAccent}}is-accent{{/if}}"><strong>{{localize this.label}}</strong>{{this.value}}</span>{{/each}}</div>
                              {{/if}}
                              {{#if this.stats.length}}
                                <div class="creature-item-stats">{{#each this.stats}}<div><span>{{localize this.label}}</span><strong>{{this.value}}</strong></div>{{/each}}</div>
                              {{/if}}
                              {{#if this.activities.length}}
                                <div class="creature-item-activities">
                                  {{#each this.activities}}
                                    <div class="activity-row">
                                      <div><strong>{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</strong><span>{{this.typeLabel}}</span></div>
                                      <div>
                                        {{#if this.activationLabel}}<span>{{this.activationLabel}}</span>{{/if}}
                                        {{#if this.attack}}<span>{{localize "BESTIARY.ItemAttack"}} {{this.attack}}</span>{{/if}}
                                        {{#if this.damage}}<span>{{localize "BESTIARY.ItemDamage"}} {{this.damage}}</span>{{/if}}
                                        {{#if this.save}}<span>{{localize "BESTIARY.ItemSave"}} {{this.save}}</span>{{/if}}
                                        {{#if this.range}}<span>{{localize "BESTIARY.ItemRange"}} {{this.range}}</span>{{/if}}
                                        {{#if this.target}}<span>{{localize "BESTIARY.ItemTarget"}} {{this.target}}</span>{{/if}}
                                      </div>
                                    </div>
                                  {{/each}}
                                </div>
                              {{/if}}
                              {{#if this.description}}<div class="creature-item-description">{{{this.description}}}</div>{{/if}}
                            </div>
                          </article>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                </section>
              {{/each}}
            </div>
          {{/if}}
        </div>

        <aside class="creature-rail">
          <nav class="rail-tabs">
            <button type="button" class="{{#if isRailKnowledge}}is-active{{/if}}" data-action="setRail" data-rail="knowledge"><i class="fas fa-brain"></i>{{localize "BESTIARY.Knowledge.Tab"}}</button>
            <button type="button" class="{{#if isRailComments}}is-active{{/if}}" data-action="setRail" data-rail="comments"><i class="far fa-comments"></i>{{localize "BESTIARY.Comments.Tab"}}{{#if comments.total}}<em>{{comments.total}}</em>{{/if}}</button>
            {{#if isGM}}
              <button type="button" class="{{#if isRailConfig}}is-active{{/if}}" data-action="setRail" data-rail="config"><i class="fas fa-layer-group"></i>{{localize "BESTIARY.Tier.Tab"}}</button>
            {{/if}}
          </nav>

          <div class="rail-body bestiary-scrollable">
            {{#if isRailKnowledge}}
              {{#if isGM}}
                <section class="rail-card">
                  <header class="party-assignment-heading"><h3>{{localize "BESTIARY.Knowledge.PartyTitle"}}</h3><p>{{localize "BESTIARY.Knowledge.PartyHint"}}</p></header>
                  <div class="party-quick-set">
                    {{#each partyTierOptions}}
                      <button type="button" data-action="setPartyTier" data-tier="{{this.value}}" {{#if ../locked}}disabled{{/if}}><i class="fas {{this.icon}}"></i>{{this.label}}</button>
                    {{/each}}
                  </div>
                </section>

                <section class="rail-card">
                  <header>
                    <h3>{{localize "BESTIARY.Knowledge.RosterTitle"}}</h3>
                    <button type="button" class="rail-inline-button" data-action="resetTiers" {{#if locked}}disabled{{/if}}><i class="fas fa-rotate-left"></i>{{localize "BESTIARY.Knowledge.Reset"}}</button>
                  </header>
                  <ul class="knowledge-roster">
                    {{#each knowledgeRoster}}
                      <li>
                        <img src="{{this.avatar}}" alt="" />
                        <div class="roster-copy">
                          <strong style="--user-color: {{this.color}}">{{this.name}}</strong>
                          <small>
                            {{#if this.characterName}}{{this.characterName}} · {{/if}}{{this.sourceLabel}}
                            {{#if this.lastRollLabel}} · {{this.lastRollLabel}}{{/if}}
                            {{#if this.blocked}} · {{localize "BESTIARY.Knowledge.Blocked"}}{{/if}}
                          </small>
                        </div>
                        <select data-user-tier="{{this.id}}" aria-label="{{localize 'BESTIARY.Knowledge.Column'}}: {{this.name}}" {{#if ../locked}}disabled{{/if}}>
                          {{#each this.tierOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
                        </select>
                      </li>
                    {{/each}}
                  </ul>
                  {{#unless knowledgeRoster.length}}<p class="rail-empty">{{localize "BESTIARY.Knowledge.NoPlayers"}}</p>{{/unless}}
                </section>
              {{else}}
                <section class="rail-card">
                  <header><h3>{{localize "BESTIARY.Knowledge.YourTitle"}}</h3><p>{{tierBadge.hint}}</p></header>
                  {{#if research.enabled}}
                    {{#if research.isMaxed}}
                      <p class="rail-note is-positive"><i class="fas fa-circle-check"></i>{{localize "BESTIARY.Research.Complete"}}</p>
                    {{else}}
                      <div class="research-panel">
                        <p class="research-target">{{localize "BESTIARY.Research.Target"}} <strong>{{research.nextTierLabel}}</strong> · {{localize "BESTIARY.Research.Dc"}} <strong>{{research.dc}}</strong></p>
                        {{#if research.actors.length}}
                          <label class="rail-field">
                            <span>{{localize "BESTIARY.Research.Actor"}}</span>
                            <select class="research-actor-select">
                              {{#each research.actors}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
                            </select>
                          </label>
                        {{/if}}
                        <label class="rail-field">
                          <span>{{localize "BESTIARY.Research.Skill"}}</span>
                          <select class="research-skill-select">
                            {{#each research.skills}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}
                          </select>
                        </label>
                        <button type="button" class="suite-primary-button" data-action="runResearch" {{#unless research.canRoll}}disabled{{/unless}}>
                          <i class="fas fa-dice-d20"></i>{{localize "BESTIARY.Research.Roll"}}
                        </button>
                        {{#if research.noActors}}<p class="rail-note is-danger"><i class="fas fa-user-slash"></i>{{localize "BESTIARY.Research.NoActor"}}</p>{{/if}}
                        {{#if research.lastRoll}}<p class="rail-note">{{research.lastRoll}}</p>{{/if}}
                        {{#if research.blocked}}<p class="rail-note is-danger"><i class="fas fa-ban"></i>{{localize "BESTIARY.Research.Blocked"}}</p>{{/if}}
                        {{#if locked}}<p class="rail-note is-danger"><i class="fas fa-lock"></i>{{localize "BESTIARY.Lock.Blocked"}}</p>{{/if}}
                      </div>
                    {{/if}}
                  {{else}}
                    <p class="rail-note">{{localize "BESTIARY.Research.Disabled"}}</p>
                  {{/if}}

                  {{#if shareEnabled}}
                    <button type="button" class="suite-secondary-button rail-wide" data-action="shareCreature"><i class="fas fa-share-nodes"></i>{{localize "BESTIARY.Share.Button"}}</button>
                  {{/if}}
                </section>
              {{/if}}
            {{/if}}

            {{#if isRailComments}}
              <section class="rail-card comments-card">
                <nav class="comment-channel-tabs">
                  {{#each comments.channels}}
                    <button type="button" class="{{#if (bjEq this.key ../commentChannel)}}is-active{{/if}}" data-action="setCommentChannel" data-channel="{{this.key}}" data-tooltip="{{this.hint}}">
                      <i class="fas {{this.icon}}"></i>{{this.label}}{{#if this.count}}<em>{{this.count}}</em>{{/if}}
                    </button>
                  {{/each}}
                </nav>

                {{#each comments.channels}}
                  {{#if (bjEq this.key ../commentChannel)}}
                    <div class="comment-list">
                      {{#each this.comments}}
                        <article class="comment-item {{#if this.isOwn}}is-own{{/if}} {{#if this.pinned}}is-pinned{{/if}} {{#if (bjEq this.id @root.editingCommentId)}}is-editing{{/if}}" data-comment-id="{{this.id}}" data-shared="{{this.shared}}" data-channel="{{this.channel}}">
                          <header>
                            <img src="{{this.authorAvatar}}" alt="" />
                            <strong style="--user-color: {{this.authorColor}}">{{this.authorName}}</strong>
                            <time>{{this.createdLabel}}{{#if this.editedLabel}} · {{localize "BESTIARY.Comments.Edited"}}{{/if}}</time>
                            {{#if this.pinned}}<i class="fas fa-thumbtack comment-pin-flag"></i>{{/if}}
                          </header>
                          <div class="comment-text">{{{this.html}}}</div>
                          <span class="comment-raw-text" hidden>{{this.text}}</span>
                          <footer class="comment-actions">
                            {{#if this.canShare}}
                              <button type="button" data-action="toggleCommentShared" class="{{#if this.shared}}is-active{{/if}}">
                                <i class="fas {{#if this.shared}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>{{this.shareLabel}}
                              </button>
                            {{/if}}
                            {{#if this.canPin}}<button type="button" data-action="pinComment" aria-label="{{localize 'BESTIARY.Comments.Pin'}}" data-tooltip="{{localize 'BESTIARY.Comments.Pin'}}"><i class="fas fa-thumbtack"></i></button>{{/if}}
                            {{#if this.canEdit}}
                              <button type="button" data-action="editComment" aria-label="{{localize 'BESTIARY.Comments.Edit'}}" data-tooltip="{{localize 'BESTIARY.Comments.Edit'}}"><i class="fas fa-pen"></i></button>
                              <button type="button" data-action="deleteComment" aria-label="{{localize 'BESTIARY.Comments.Delete'}}" data-tooltip="{{localize 'BESTIARY.Comments.Delete'}}"><i class="fas fa-trash"></i></button>
                            {{/if}}
                          </footer>
                        </article>
                      {{/each}}
                      {{#unless this.comments.length}}<p class="rail-empty">{{localize "BESTIARY.Comments.Empty"}}</p>{{/unless}}
                    </div>

                    {{#if this.canPost}}
                      <div class="comment-composer">
                        {{#if @root.isEditingComment}}<p class="comment-editing-note"><i class="fas fa-pen"></i>{{localize "BESTIARY.Comments.Editing"}}</p>{{/if}}
                        <textarea class="comment-composer-input" rows="3" placeholder="{{localize 'BESTIARY.Comments.Placeholder'}}"></textarea>
                        <div class="comment-composer-actions">
                          {{#if @root.isEditingComment}}
                            <button type="button" class="suite-secondary-button" data-action="cancelEdit"><i class="fas fa-xmark"></i>{{localize "BESTIARY.Comments.CancelEdit"}}</button>
                          {{else if (bjEq this.key "gm")}}
                            <label class="comment-share-field">
                              <input type="checkbox" class="comment-share-toggle" />
                              <span>{{localize "BESTIARY.Comments.PostShared"}}</span>
                            </label>
                          {{/if}}
                          <button type="button" class="suite-primary-button" data-action="submitComment">
                            <i class="fas fa-paper-plane"></i>{{#if ../editingCommentId}}{{localize "BESTIARY.Comments.SaveEdit"}}{{else}}{{localize "BESTIARY.Comments.Post"}}{{/if}}
                          </button>
                        </div>
                      </div>
                    {{/if}}
                  {{/if}}
                {{/each}}

                {{#if comments.locked}}
                  <p class="rail-note is-danger"><i class="fas fa-lock"></i>{{localize "BESTIARY.Lock.CommentsBlocked"}}</p>
                {{/if}}
              </section>
            {{/if}}

            {{#if isRailConfig}}
              <section class="rail-card">
                <header>
                  <h3>{{localize "BESTIARY.Tier.EntryTitle"}}</h3>
                  <button type="button" class="rail-inline-button" data-action="resetBlockTiers" {{#if locked}}disabled{{/if}}><i class="fas fa-rotate-left"></i>{{localize "BESTIARY.Tier.Reset"}}</button>
                </header>
                <p class="rail-hint">{{localize "BESTIARY.Tier.EntryHint"}}</p>
                {{#each tierMatrix}}
                  <div class="tier-group">
                    <h4><i class="fas {{this.icon}}"></i>{{this.label}}{{#if this.overrideCount}}<em>{{this.overrideCount}}</em>{{/if}}</h4>
                    {{#each this.blocks}}
                      <label class="tier-row {{#if this.isChild}}is-child{{/if}} {{#if this.isOverridden}}is-overridden{{/if}} {{#if this.isNever}}is-never{{/if}}">
                        <span>{{this.label}}</span>
                        <select data-block-tier="{{this.key}}" {{#if ../../locked}}disabled{{/if}}>
                          {{#each this.choices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
                        </select>
                      </label>
                    {{/each}}
