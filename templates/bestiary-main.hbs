<div class="bestiary-shell">
  <aside class="library-sidebar" aria-label="{{localize 'BESTIARY.LibraryNavigation'}}">
    <div class="library-brand">
      <span class="library-brand-mark"><i class="fas fa-book-skull"></i></span>
      <div>
        <strong>{{localize "BESTIARY.Title"}}</strong>
        <small>{{localize "BESTIARY.Library"}}</small>
      </div>
    </div>

    <nav class="library-primary-nav">
      <button type="button" class="library-nav-item {{#if isOverview}}is-active{{/if}}" data-action="setLibraryView" data-library-view="overview" data-tooltip="{{localize 'BESTIARY.Overview'}}">
        <i class="fas fa-house"></i><span>{{localize "BESTIARY.Overview"}}</span>
      </button>
      <button type="button" class="library-nav-item {{#if isAll}}is-active{{/if}}" data-action="setLibraryView" data-library-view="all" data-tooltip="{{localize 'BESTIARY.AllCreatures'}}">
        <i class="fas fa-table-cells-large"></i><span>{{localize "BESTIARY.AllCreatures"}}</span><strong>{{totalCreatures}}</strong>
      </button>
      <button type="button" class="library-nav-item {{#if isRecent}}is-active{{/if}}" data-action="setLibraryView" data-library-view="recent" data-tooltip="{{localize 'BESTIARY.Recent'}}">
        <i class="far fa-clock"></i><span>{{localize "BESTIARY.Recent"}}</span>
      </button>
      <button type="button" class="library-nav-item {{#if isFavorites}}is-active{{/if}}" data-action="setLibraryView" data-library-view="favorites" data-tooltip="{{localize 'BESTIARY.Favorites'}}">
        <i class="far fa-star"></i><span>{{localize "BESTIARY.Favorites"}}</span><strong>{{favoriteCount}}</strong>
      </button>
    </nav>

    <div class="library-sidebar-heading"><span>{{localize "BESTIARY.Collections"}}</span><em>{{collectionCount}}</em></div>
    <nav class="library-collection-nav bestiary-scrollable">
      {{#each sections}}
        <button type="button" class="library-nav-item {{#if this.isHidden}}is-muted{{/if}}" data-action="openSection" data-section-id="{{this.id}}" data-tooltip="{{this.name}}">
          <i class="far fa-folder"></i>
          <span title="{{this.name}}">{{this.name}}</span>
          {{#if this.isLocked}}<i class="fas fa-lock library-nav-flag"></i>{{/if}}
          <strong>{{this.creatureCount}}</strong>
        </button>
      {{/each}}
    </nav>

    <div class="library-sidebar-footer">
      {{#if isGM}}
        <button type="button" class="library-new-button" data-action="createSection" data-tooltip="{{localize 'BESTIARY.NewCollection'}}"><i class="fas fa-plus"></i><span>{{localize "BESTIARY.NewCollection"}}</span></button>
        <div class="library-footer-tools">
          <button type="button" data-action="importSnapshot" data-tooltip="{{localize 'BESTIARY.Transfer.Import'}}"><i class="fas fa-file-import"></i></button>
          <button type="button" data-action="exportAll" data-tooltip="{{localize 'BESTIARY.Transfer.ExportAll'}}"><i class="fas fa-file-export"></i></button>
          <button type="button" data-action="openTierSettings" data-tooltip="{{localize 'BESTIARY.Tier.WorldTitle'}}"><i class="fas fa-layer-group"></i></button>
        </div>
      {{/if}}
    </div>
  </aside>

  <main class="library-workspace">
    <header class="library-toolbar">
      <div class="library-heading">
        <p class="library-eyebrow">{{localize "BESTIARY.Library"}}</p>
        <h1>{{#if isOverview}}{{localize "BESTIARY.Title"}}{{else}}{{viewTitle}}{{/if}}</h1>
      </div>

      <div class="library-stat-row">
        <div class="library-stat"><strong>{{totalCreatures}}</strong><span>{{localize "BESTIARY.Creatures"}}</span></div>
        <div class="library-stat"><strong>{{collectionCount}}</strong><span>{{localize "BESTIARY.Collections"}}</span></div>
        {{#unless isGM}}<div class="library-stat is-accent"><strong>{{knownCount}}</strong><span>{{localize "BESTIARY.Knowledge.Known"}}</span></div>{{/unless}}
        <div class="library-stat"><strong>{{favoriteCount}}</strong><span>{{localize "BESTIARY.Favorites"}}</span></div>
      </div>

      <div class="library-toolbar-row">
        <label class="library-search">
          <i class="fas fa-magnifying-glass"></i>
          <input type="search" class="library-search-input" placeholder="{{localize 'BESTIARY.SearchLibrary'}}" />
          <button type="button" class="library-search-clear" data-action="clearSearch" aria-label="{{localize 'BESTIARY.ClearSearch'}}"><i class="fas fa-xmark"></i></button>
        </label>
        {{#unless isOverview}}
          <div class="suite-segmented suite-view-switch" aria-label="{{localize 'BESTIARY.ViewMode'}}">
            <button type="button" class="{{#if isGrid}}is-active{{/if}}" data-action="toggleCreatureLayout" data-layout="grid" data-tooltip="{{localize 'BESTIARY.ViewCard'}}"><i class="fas fa-table-cells-large"></i></button>
            <button type="button" class="{{#unless isGrid}}is-active{{/unless}}" data-action="toggleCreatureLayout" data-layout="list" data-tooltip="{{localize 'BESTIARY.ViewList'}}"><i class="fas fa-list"></i></button>
          </div>
        {{/unless}}
      </div>
    </header>

    <div class="library-scroll bestiary-scrollable">
      {{#if isOverview}}
        <section class="library-section-block">
          <div class="library-section-title">
            <div><h2>{{localize "BESTIARY.Collections"}}</h2><p>{{localize "BESTIARY.CollectionsHint"}}</p></div>
          </div>
          <div class="collection-grid">
            {{#each sections}}
              <article class="collection-card {{#if this.isHidden}}is-hidden{{/if}} {{#if this.isLocked}}is-locked{{/if}}"
                       data-section-id="{{this.id}}" data-hidden="{{this.isHidden}}" data-locked="{{this.isLocked}}"
                       data-search-text="{{this.searchText}}" data-action="openSection" tabindex="0">
                <img src="{{this.displayImage}}" alt="{{this.name}}" loading="lazy" />
                <div class="collection-scrim"></div>
                <div class="collection-card-copy">
                  <h3 title="{{this.name}}">{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</h3>
                  <p>
                    <span>{{this.creatureCount}} {{localize "BESTIARY.Creatures"}}</span>
                    {{#if this.familyCount}}<span>· {{this.familyCount}} {{localize "BESTIARY.Families.Short"}}</span>{{/if}}
                    {{#if this.updatedLabel}}<span>· {{this.updatedLabel}}</span>{{/if}}
                  </p>
                </div>
                <div class="collection-card-flags">
                  {{#if this.isHidden}}<span class="suite-badge is-warning" data-tooltip="{{localize 'BESTIARY.HiddenFromPlayers'}}"><i class="fas fa-eye-slash"></i></span>{{/if}}
                  {{#if this.isLocked}}<span class="suite-badge is-locked" data-tooltip="{{localize 'BESTIARY.Lock.Locked'}}"><i class="fas fa-lock"></i></span>{{/if}}
                </div>
                {{#if ../isGM}}
                  <button type="button" class="collection-menu-button" data-action="editSection" aria-label="{{localize 'BESTIARY.EditSection'}}"><i class="fas fa-ellipsis"></i></button>
                {{/if}}
              </article>
            {{/each}}
            {{#if isGM}}
              <button type="button" class="collection-card collection-card-new" data-action="createSection">
                <span><i class="fas fa-plus"></i></span>
                <strong>{{localize "BESTIARY.NewCollection"}}</strong>
                <small>{{localize "BESTIARY.CreateCollectionHint"}}</small>
              </button>
            {{/if}}
          </div>
        </section>

        <section class="library-section-block library-search-results">
          <div class="library-section-title">
            <div><h2>{{localize "BESTIARY.SearchResults"}}</h2></div>
          </div>
          <div class="library-creature-grid is-search-grid">
            {{#each displayedCreatures}}
              <article class="library-creature-card {{#if this.isFavorite}}is-favorite{{/if}}" data-uuid="{{this.uuid}}" data-search-text="{{this.searchText}}" data-action="openCreature" draggable="true" tabindex="0">
                <div class="library-creature-image">
                <div class="{{this.image.frameClass}}">
                  {{#if this.image.useBackdrop}}<div class="bestiary-frame-backdrop" style="{{this.image.backdropStyle}}"></div>{{/if}}
                  <img src="{{this.image.src}}" alt="{{this.name}}" style="{{this.image.imageStyle}}" loading="lazy" />
                </div>
                {{#if this.knowsCr}}<span class="creature-cr-chip">{{localize "BESTIARY.CRShort"}} {{this.crFormatted}}</span>{{/if}}
              </div>
                <div class="library-creature-copy">
                <h3 class="{{#unless this.knowsName}}is-unknown{{/unless}}" title="{{this.name}}">{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</h3>
                <p>{{this.typeLabel}}</p>
                <small>{{this.collectionLabel}}</small>
              </div>
                <div class="library-creature-meta">
                {{#if this.tierBadge}}<span class="tier-chip is-{{this.tierBadge.key}}" {{#if this.tierBadge.tooltip}}data-tooltip="{{this.tierBadge.tooltip}}"{{/if}}><i class="fas {{this.tierBadge.icon}}"></i>{{this.tierBadge.label}}</span>{{/if}}
              </div>
                <div class="library-creature-actions">
                <button type="button" data-action="toggleFavorite" aria-label="{{localize 'BESTIARY.ToggleFavorite'}}" data-tooltip="{{localize 'BESTIARY.ToggleFavorite'}}"><i class="{{#if this.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></button>
                {{#if @root.isGM}}<button type="button" data-action="openSheet" aria-label="{{localize 'BESTIARY.OpenSheet'}}" data-tooltip="{{localize 'BESTIARY.OpenSheet'}}"><i class="fas fa-arrow-up-right-from-square"></i></button>{{/if}}
              </div>
            </article>
            {{/each}}
          </div>
          <p class="library-search-empty">{{localize "BESTIARY.NoMatchingCreatures"}}</p>
        </section>

        {{#if recentCreatures.length}}
          <section class="library-section-block library-recent-block">
            <div class="library-section-title">
              <div><h2>{{localize "BESTIARY.RecentlyAdded"}}</h2><p>{{localize "BESTIARY.RecentlyAddedHint"}}</p></div>
              <button type="button" data-action="setLibraryView" data-library-view="recent">{{localize "BESTIARY.ShowAll"}}<i class="fas fa-arrow-right"></i></button>
            </div>
            <div class="recent-creature-strip bestiary-scrollable">
              {{#each recentCreatures}}
                <article class="recent-creature-card" data-uuid="{{this.uuid}}" data-action="openCreature" draggable="true" tabindex="0">
                  <div class="{{this.image.frameClass}}">
                    {{#if this.image.useBackdrop}}<div class="bestiary-frame-backdrop" style="{{this.image.backdropStyle}}"></div>{{/if}}
                    <img src="{{this.image.src}}" alt="{{this.name}}" style="{{this.image.imageStyle}}" loading="lazy" />
                  </div>
                  <div class="collection-scrim"></div>
                  <div class="recent-creature-copy">
                    <strong class="{{#unless this.knowsName}}is-unknown{{/unless}}" title="{{this.name}}">{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</strong>
                    <span>{{this.typeLabel}}</span>
                  </div>
                  {{#if this.tierBadge}}<span class="tier-chip is-{{this.tierBadge.key}}"><i class="fas {{this.tierBadge.icon}}"></i>{{this.tierBadge.label}}</span>{{/if}}
                </article>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if noSections}}
          <div class="suite-empty-state">
            <i class="fas fa-folder-open"></i>
            <h2>{{localize "BESTIARY.NoSections"}}</h2>
            {{#if isGM}}<button type="button" class="suite-primary-button" data-action="createSection"><i class="fas fa-plus"></i>{{localize "BESTIARY.NewCollection"}}</button>{{/if}}
          </div>
        {{/if}}
      {{else}}
        <div class="library-creature-grid {{#unless isGrid}}is-list{{/unless}}">
          {{#each displayedCreatures}}
            <article class="library-creature-card {{#if this.isFavorite}}is-favorite{{/if}}" data-uuid="{{this.uuid}}" data-search-text="{{this.searchText}}" data-action="openCreature" draggable="true" tabindex="0">
              <div class="library-creature-image">
                <div class="{{this.image.frameClass}}">
                  {{#if this.image.useBackdrop}}<div class="bestiary-frame-backdrop" style="{{this.image.backdropStyle}}"></div>{{/if}}
                  <img src="{{this.image.src}}" alt="{{this.name}}" style="{{this.image.imageStyle}}" loading="lazy" />
                </div>
                {{#if this.knowsCr}}<span class="creature-cr-chip">{{localize "BESTIARY.CRShort"}} {{this.crFormatted}}</span>{{/if}}
              </div>
              <div class="library-creature-copy">
                <h3 class="{{#unless this.knowsName}}is-unknown{{/unless}}" title="{{this.name}}">{{#each (bjNameParts this.name)}}<span class="bestiary-name-part">{{this}}</span>{{/each}}</h3>
                <p>{{this.typeLabel}}</p>
                <small>{{this.collectionLabel}}</small>
              </div>
              <div class="library-creature-meta">
                {{#if this.tierBadge}}<span class="tier-chip is-{{this.tierBadge.key}}" {{#if this.tierBadge.tooltip}}data-tooltip="{{this.tierBadge.tooltip}}"{{/if}}><i class="fas {{this.tierBadge.icon}}"></i>{{this.tierBadge.label}}</span>{{/if}}
              </div>
              <div class="library-creature-actions">
                <button type="button" data-action="toggleFavorite" aria-label="{{localize 'BESTIARY.ToggleFavorite'}}" data-tooltip="{{localize 'BESTIARY.ToggleFavorite'}}"><i class="{{#if this.isFavorite}}fas{{else}}far{{/if}} fa-star"></i></button>
                {{#if @root.isGM}}<button type="button" data-action="openSheet" aria-label="{{localize 'BESTIARY.OpenSheet'}}" data-tooltip="{{localize 'BESTIARY.OpenSheet'}}"><i class="fas fa-arrow-up-right-from-square"></i></button>{{/if}}
              </div>
            </article>
          {{/each}}
        </div>
        {{#if noCreatures}}<div class="suite-empty-state"><i class="far fa-star"></i><h2>{{localize "BESTIARY.NoMatchingCreatures"}}</h2></div>{{/if}}
      {{/if}}
    </div>
  </main>
</div>
