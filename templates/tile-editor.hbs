<section class="tile-editor-form">
  <div class="tile-editor-preview {{#unless image}}is-empty{{/unless}}">
    <img src="{{image}}" alt="" class="{{#unless image}}is-empty{{/unless}}" />
    <div class="tile-editor-preview-actions">
      <button type="button" class="btn-pick-image" data-action="pickImage">
        <i class="fa-solid fa-image"></i>{{localize imageLabel}}
      </button>
      {{#if image}}
        <button type="button" class="btn-clear-image" data-action="clearImage" data-tooltip="{{localize 'BESTIARY.Entry.ClearImage'}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
      {{/if}}
    </div>
  </div>

  <input type="hidden" name="image" value="{{image}}" />

  <div class="form-group">
    <label>{{localize nameLabel}}</label>
    <input type="text" name="name" value="{{name}}" placeholder="{{localize nameLabel}}" required autofocus />
    <p class="form-hint">{{localize hint}}</p>
  </div>

  <div class="form-group form-group-checkbox">
    <label>
      <input type="checkbox" name="hidden" {{#if isHidden}}checked{{/if}} />
      <i class="fa-solid fa-eye-slash"></i>
      {{localize "BESTIARY.HiddenFromPlayers"}}
    </label>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="submit" class="suite-primary-button">
      <i class="fa-solid fa-check"></i> {{localize "BESTIARY.Save"}}
    </button>
  </footer>
</section>
