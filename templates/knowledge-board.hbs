<section class="knowledge-board-shell">
  <header class="knowledge-board-header">
    <h1>{{localize "BESTIARY.Board.Title"}}</h1>
    <div class="knowledge-board-filters">
      <search class="bestiary-search-landmark">
        <label class="library-search board-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span class="sr-only">{{localize "BESTIARY.Board.Search"}}</span>
          <input type="search" class="board-search-input" placeholder="{{localize 'BESTIARY.Board.Search'}}" />
        </label>
      </search>
      <label class="bulk-field">
        <span>{{localize "BESTIARY.Board.Scope"}}</span>
        <select class="board-scope">
          {{#each scopes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </label>
      {{#if hasFamilies}}
        <label class="bulk-field">
          <span>{{localize "BESTIARY.Board.Family"}}</span>
          <select class="board-family">
            {{#each families}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </label>
      {{/if}}
    </div>
  </header>

  <div class="knowledge-board-controls">
    <div class="board-selection-bar">
      <span class="board-selection-status">{{#if selectedCount}}{{selectedLabel}}{{else}}{{localize "BESTIARY.Board.SelectHint"}}{{/if}}</span>
      <button type="button" class="rail-inline-button" data-action="clearSelection" {{#unless selectedCount}}hidden{{/unless}}>
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>{{localize "BESTIARY.ClearAll"}}
      </button>
    </div>
    <div class="board-bulk-actions">
      <label class="bulk-field">
        <span>{{localize "BESTIARY.Board.BulkTier"}}</span>
        <select class="board-bulk-tier">
          {{#each tierOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </label>
      <label class="bulk-field">
        <span>{{localize "BESTIARY.Board.BulkWho"}}</span>
        <select class="board-bulk-user">
          <option value="">{{localize "BESTIARY.Board.WholeParty"}}</option>
          {{#each players}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </select>
      </label>
      <button type="button" class="suite-primary-button" data-action="applySelected" {{#unless selectedCount}}disabled{{/unless}}>
        <i class="fa-solid fa-check-double" aria-hidden="true"></i><span>{{applySelectedLabel}}</span>
      </button>
      <button type="button" class="suite-secondary-button" data-action="applyAll" {{#unless unlockedCount}}disabled{{/unless}}>
        <span>{{applyAllLabel}}</span>
      </button>
    </div>
  </div>

  {{#if players.length}}
    <div class="knowledge-board-table bestiary-scrollable">
      <table>
        <thead>
          <tr>
            <th scope="col" class="board-check-col">
              <input type="checkbox" class="board-select-all" aria-label="{{localize 'BESTIARY.Board.SelectAllVisible'}}" />
            </th>
            <th scope="col">{{localize "BESTIARY.Creature"}}</th>
            <th scope="col" class="board-party-col">{{localize "BESTIARY.Board.PartyColumn"}}</th>
            {{#each players}}
              <th scope="col" style="--user-color: {{this.color}}"><img src="{{this.avatar}}" alt="" /><span>{{this.name}}</span></th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
            <tr class="{{#if this.locked}}is-locked{{/if}} {{#if this.selected}}is-selected{{/if}}" data-uuid="{{this.uuid}}" data-search-text="{{this.searchText}}">
              <td class="board-check-col">
                <input type="checkbox" class="board-row-check" data-uuid="{{this.uuid}}" aria-label="{{bjFormat 'BESTIARY.Board.SelectRow' name=this.name}}" {{#if this.selected}}checked{{/if}} {{#if this.locked}}disabled{{/if}} />
              </td>
              <th scope="row">
                <img src="{{this.img}}" alt="" />
                <span>{{this.name}}</span>
                {{#if this.locked}}<i class="fa-solid fa-lock" data-tooltip="{{localize 'BESTIARY.Lock.Locked'}}"></i>{{/if}}
              </th>
              <td class="board-party-col">
                <select class="board-party-tier is-{{this.partyKey}} {{#if this.partyIsMixed}}is-mixed{{/if}}" {{#if this.partyColor}}data-tier-color="{{this.partyColor}}"{{/if}} data-uuid="{{this.uuid}}" aria-label="{{localize 'BESTIARY.Board.PartyColumn'}}: {{this.name}}" {{#if this.locked}}disabled{{/if}}>
                  {{#each this.partyOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
                </select>
              </td>
              {{#each this.cells}}
                <td>
                  <select class="board-tier is-{{this.key}}" data-tier-color="{{this.color}}" data-uuid="{{../uuid}}" data-user-id="{{this.userId}}" aria-label="{{../name}}" {{#if ../locked}}disabled{{/if}}>
                    {{#each this.options}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
                  </select>
                </td>
              {{/each}}
            </tr>
          {{/each}}
        </tbody>
      </table>
      <div class="suite-empty-state is-inline board-search-empty" hidden><i class="fa-solid fa-magnifying-glass"></i><h2>{{localize "BESTIARY.NoMatchingCreatures"}}</h2></div>
      {{#unless rows.length}}<div class="suite-empty-state"><i class="fa-solid fa-inbox"></i><h2>{{localize "BESTIARY.Board.NoCreatures"}}</h2></div>{{/unless}}
    </div>
  {{else}}
    <div class="suite-empty-state"><i class="fa-solid fa-user-slash"></i><h2>{{localize "BESTIARY.Board.NoPlayers"}}</h2></div>
  {{/if}}
</section>
